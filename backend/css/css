
:root {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #202b26;
  background: #f6f8f6;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: 3px solid #92cdb1;
  outline-offset: 3px;
}

.app-shell {
  width: min(1180px, 100% - 40px);
  margin: 0 auto;
}

.loading {
  padding: 60px 20px;
  text-align: center;
  color: #53645a;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 22px 0;
  border-bottom: 1px solid #e5eae5;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: inherit;
  text-decoration: none;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 13px;
  color: white;
  background: #176b4d;
  font-size: 23px;
  font-weight: 800;
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  font-size: 19px;
  letter-spacing: -0.5px;
}

.brand small {
  margin-top: 4px;
  color: #77847b;
  font-size: 10px;
  letter-spacing: 1.4px;
}

.navigation {
  display: flex;
  gap: 6px;
}

.nav-btn {
  padding: 11px 16px;
  border: 1px solid transparent;
  border-radius: 9px;
  color: #5b685f;
  background: transparent;
  font-weight: 600;
}

.nav-btn:hover {
  background: #edf3ee;
}

.nav-btn.active {
  color: #176b4d;
  background: #e6f3e9;
}

.welcome {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 42px 0 30px;
}

.eyebrow {
  margin: 0 0 10px;
  color: #176b4d;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.welcome h1 {
  margin: 0;
  font-size: clamp(27px, 4vw, 38px);
  line-height: 1.15;
  letter-spacing: -1.3px;
}

.muted {
  color: #758078;
  line-height: 1.6;
}

.welcome .muted {
  margin-bottom: 0;
}

.store-badge,
.stock-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  width: fit-content;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.store-badge {
  padding: 10px 13px;
  border: 1px solid #dce8df;
  background: white;
  white-space: nowrap;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #1a9b65;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 42px;
}

.stat-card {
  padding: 22px;
  border: 1px solid #e7ebe7;
  border-radius: 15px;
  background: white;
  box-shadow: 0 3px 12px rgb(25 50 35 / 3%);
}

.stat-label,
.stat-note {
  display: block;
}

.stat-label {
  color: #6f7b72;
  font-size: 13px;
  font-weight: 600;
}

.stat-card strong {
  display: block;
  margin: 13px 0 6px;
  font-size: 31px;
  letter-spacing: -1px;
}

.stat-note {
  color: #929b94;
  font-size: 12px;
}

.content-section {
  padding: 28px;
  border: 1px solid #e7ebe7;
  border-radius: 17px;
  background: white;
  box-shadow: 0 4px 20px rgb(25 50 35 / 3%);
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 23px;
}

.section-heading h2 {
  margin: 0;
  font-size: 21px;
  letter-spacing: -0.5px;
}

.section-heading p {
  margin: 7px 0 0;
  font-size: 13px;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 39px;
  padding: 10px 15px;
  border: 1px solid transparent;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
  transition: background 150ms ease, transform 150ms ease;
}

.primary-btn {
  color: white;
  background: #176b4d;
}

.primary-btn:hover {
  background: #10583e;
}

.primary-btn:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.secondary-btn {
  border-color: #e0e6e0;
  color: #35443a;
  background: white;
}

.secondary-btn:hover {
  background: #f2f6f2;
}

.danger-btn {
  border-color: #f1d9d7;
  color: #b93832;
  background: #fff8f7;
}

.danger-btn:hover {
  background: #ffebe9;
}

.search-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  padding: 0 14px;
  border: 1px solid #e0e6e0;
  border-radius: 10px;
  color: #7b887e;
}

.search-wrap input {
  width: 100%;
  min-height: 45px;
  border: 0;
  outline: none;
  background: transparent;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
  gap: 20px;
}

.product-card {
  overflow: hidden;
  border: 1px solid #e6ebe6;
  border-radius: 13px;
  background: white;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.product-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgb(25 50 35 / 8%);
}

.product-image {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  background: #f0f3ef;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.stock-badge {
  padding: 6px 9px;
}

.product-image .stock-badge {
  position: absolute;
  top: 12px;
  left: 12px;
}

.in-stock {
  color: #14774d;
  background: #e4f6eb;
}

.out-stock {
  color: #b53b36;
  background: #fff0ee;
}

.product-info {
  padding: 16px;
}

.product-info h3 {
  min-height: 42px;
  margin: 0 0 9px;
  font-size: 15px;
  line-height: 1.4;
}

.product-price {
  font-size: 20px;
  letter-spacing: -0.4px;
}

.product-info .muted {
  margin: 7px 0 15px;
  font-size: 12px;
}

.full-btn {
  width: 100%;
}

.product-form {
  margin-bottom: 38px;
  padding: 22px;
  border: 1px solid #e6ebe6;
  border-radius: 13px;
  background: #fafcf9;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 19px;
}

.form-grid label {
  display: grid;
  gap: 8px;
  color: #455249;
  font-size: 13px;
  font-weight: 700;
}

.form-grid input {
  width: 100%;
  min-width: 0;
  min-height: 43px;
  padding: 11px 12px;
  border: 1px solid #dfe6df;
  border-radius: 8px;
  color: #26342a;
  background: white;
}

.form-grid input:focus {
  border-color: #5d9f7c;
  outline: 2px solid #d7ebde;
}

.form-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 22px;
}

.table-heading {
  margin-top: 15px;
}

.table-wrap {
  overflow-x: auto;
  border: 1px solid #e8ece8;
  border-radius: 11px;
}

.inventory-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
}

.inventory-table th {
  padding: 14px;
  color: #758078;
  background: #f7f9f7;
  font-size: 11px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.inventory-table td {
  padding: 13px 14px;
  border-top: 1px solid #edf0ed;
  font-size: 13px;
}

.table-product {
  display: flex;
  align-items: center;
  gap: 11px;
  white-space: normal;
}

.table-product img {
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  border-radius: 8px;
  object-fit: cover;
  background: #f0f3ef;
}

.action-group {
  display: flex;
  gap: 7px;
}

.notice {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  padding: 13px 16px;
  border: 1px solid #d8e9dd;
  border-radius: 10px;
  color: #245b3d;
  background: #edf7ef;
  font-size: 13px;
}

.notice button {
  border: 0;
  color: inherit;
  background: transparent;
  font-size: 22px;
}

.empty-state {
  padding: 55px 15px;
  text-align: center;
  border: 1px dashed #d9e2d9;
  border-radius: 12px;
}

.empty-state h3 {
  margin: 0;
}

.empty-state p {
  color: #758078;
  font-size: 13px;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 25px 0;
  color: #879188;
  font-size: 12px;
}

@media (max-width: 700px) {
  .app-shell {
    width: calc(100% - 28px);
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 17px;
  }

  .navigation {
    width: 100%;
  }

  .nav-btn {
    flex: 1;
    padding: 10px 7px;
    font-size: 12px;
  }

  .welcome {
    align-items: flex-start;
    flex-direction: column;
    padding-top: 30px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
    gap: 11px;
    margin-bottom: 25px;
  }

  .stat-card {
    padding: 16px;
  }

  .stat-card strong {
    margin: 8px 0 4px;
    font-size: 25px;
  }

  .content-section {
    padding: 17px;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .product-info {
    padding: 11px;
  }

  .product-info h3 {
    font-size: 13px;
  }

  .product-price {
    font-size: 17px;
  }

  .product-info .muted {
    font-size: 11px;
  }

  .product-info .secondary-btn {
    padding: 9px 7px;
    font-size: 11px;
  }

  .footer {
    font-size: 11px;
  }
}

@media (max-width: 380px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}
